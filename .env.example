# انسخ هذا الملف باسم .env، ثم استبدل القيم التالية ببياناتك.
# لا ترفع ملف .env إلى Git أو تشاركه مع أي طرف.

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=put_your_api_hash_here
TELEGRAM_BOT_TOKEN=put_your_bot_token_here
TELEGRAM_ADMIN_ID=123456789

# اتركه فارغًا لتعطيل شرط الاشتراك بالقناة.
REQUIRED_CHANNEL=enmotaz

# إعدادات التشغيل الاختيارية
# محليًا اتركه كما هو؛ في Railway اضبطه على مسار وحدة التخزين، مثل /data.
BOT_DATA_DIR=database
PORT=10000
LOG_LEVEL=INFO
MIN_POST_INTERVAL=60
MAX_GROUPS_PER_CYCLE=15
MAX_GROUPS_TURBO=10
